# Copier ce fichier en .env.local (ignoré par git) et compléter si besoin.
# Aucune valeur secrète ne doit être écrite ici.

# URL publique du site. Obligatoire en production seulement (validée par zod).
# En local, la valeur par défaut est http://localhost:3000 ; en preview Vercel, elle est
# calculée depuis VERCEL_BRANCH_URL.
NEXT_PUBLIC_SITE_URL=

# "true" autorise l'indexation par les moteurs de recherche. Reste à "false" (site fictif).
ALLOW_INDEXING=false

# Date du jour forcée (AAAA-MM-JJ), pour les tests uniquement. Jamais en production.
VS_TODAY=

# Les variables Supabase sont ajoutées à l'étape 4.
